<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact | Rețete de vânătoare</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>Contactează-ne</h1>
    <nav>
      <a href="/">Acasă</a>
      <a href="/adauga">Adaugă rețetă</a>
      <a href="/abonament">Abonament</a>
      <a href="/contact">Contact</a>
    </nav>
  </header>

  <main>
    <h2>Trimite-ne un mesaj</h2>
    <form class="formular">
      <label for="nume">Nume:</label>
      <input type="text" id="nume" name="nume" placeholder="Ion Popescu">

      <label for="email">Email:</label>
      <input type="email" id="email" name="email" placeholder="ion.popescu@email.com">

      <label for="mesaj">Mesaj:</label>
      <textarea id="mesaj" name="mesaj" rows="5" placeholder="Scrie mesajul tău aici..."></textarea>

      <button type="submit">Trimite mesajul</button>
    </form>
  </main>

  <footer>
    <p>© 2025 Rețete de vânătoare | Toate drepturile rezervate</p>
  </footer>
</body>
</html>
